# Meet2Notes only listens on the loopback interface by default.
M2N_HOST=127.0.0.1
M2N_PORT=8765
M2N_LOG_LEVEL=INFO
M2N_MAX_UPLOAD_MB=2048
# M2N_DATA_DIR=/absolute/path/to/private/local/data
# M2N_MODELS_DIR=D:\Meet2Notes\Models
# M2N_FFMPEG_PATH=/absolute/path/to/ffmpeg
# Required only to download Pyannote Community-1 after accepting its model terms.
# M2N_PYANNOTE_TOKEN=hf_your_token_here

# --- CRM integration (verification against the local mock CRM) ---
# Leave unset to disable all /api/crm routes (fail-closed).
# Plain HTTP is only accepted for loopback hosts (local verification); anything
# else must use HTTPS. Never put real CRM tokens in committed files.
# M2N_CRM_BASE_URL=http://127.0.0.1:8766
# M2N_CRM_AGENDA_PATH=/api/crm/meetings/{meeting_code}/agenda
# M2N_CRM_TRANSCRIPTS_PATH=/api/crm/transcripts
# M2N_CRM_SUMMARY_PATH=/api/crm/summaries
# M2N_CRM_MEETING_ENDED_PATH=/api/crm/meetings/{meeting_code}/ended
# M2N_CRM_HEALTH_PATH=/api/health
# M2N_CRM_TIMEOUT_SECONDS=10
# M2N_CRM_TOKEN=
